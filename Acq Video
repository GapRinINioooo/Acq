<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AcQ Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<style>
:root{--bg:#eef1ef;--card:#fff;--ink:#17201d;--mut:#5d6b66;--line:#d6ddd9;--g:#0f5c4d;--g2:#6bb3a0;--a:#e0a400;--r:#c2412d;--b:#3a6ea5;--p:#8a6bb0}
@media(prefers-color-scheme:dark){:root{--bg:#121816;--card:#1a2321;--ink:#e6eeea;--mut:#93a39d;--line:#2b3834;--g:#4fb99f;--g2:#2d7f6b;--a:#f0b429;--r:#e5604b;--b:#6aa0d8;--p:#b497d6}}
*{box-sizing:border-box}
html{height:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 "IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;padding:0 16px 40px}
header{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;padding:20px 0 12px}
h1{font-size:22px;font-weight:600;margin:0}
.sub{color:var(--mut);font-size:13px}
.btn{background:var(--g);color:#fff;border:0;border-radius:6px;padding:8px 14px;font:inherit;cursor:pointer}
.btn:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--b);outline-offset:2px}
.filters{display:flex;flex-wrap:wrap;gap:10px;padding:10px 0 14px;border-top:1px solid var(--line)}
label{display:flex;flex-direction:column;gap:3px;color:var(--mut);font-size:12px}
select,input[type=search]{background:var(--card);color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:6px 8px;font:inherit;min-width:140px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));background:var(--card);border:1px solid var(--line);border-radius:8px;margin-bottom:14px}
.kpi{padding:14px 16px;border-right:1px solid var(--line)}
.kpi:last-child{border-right:0}
.kpi b{display:block;font-size:26px;font-weight:600;letter-spacing:-.5px}
.kpi span{color:var(--mut);font-size:12px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:14px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:14px}
.panel.wide{grid-column:1/-1}
.panel h2{font-size:14px;font-weight:600;margin:0 0 10px}
.box{position:relative;height:260px}
.box.tall{height:340px}
.tbl{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:13px;min-width:900px}
th,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--line);white-space:nowrap;max-width:240px;overflow:hidden;text-overflow:ellipsis}
th{color:var(--mut);font-weight:500;position:sticky;top:0;background:var(--card)}
.tag{display:inline-block;padding:1px 8px;border-radius:10px;font-size:12px;border:1px solid var(--line)}
#drop{border:2px dashed var(--line);border-radius:8px;padding:40px;text-align:center;color:var(--mut)}
#drop.over{border-color:var(--g);color:var(--ink)}
.hide{display:none!important}
@media(max-width:600px){.kpi{border-right:0;border-bottom:1px solid var(--line)}}
</style>
</head>
<body>
<header>
  <div>
    <h1>Video Acquisition 2026</h1>
    <div class="sub" id="upd">No data loaded</div>
  </div>
  <div>
    <input type="file" id="file" accept=".csv" class="hide">
    <button class="btn" id="pick">Load CSV</button>
  </div>
</header>

<div id="drop">Drop the exported CSV here, or press Load CSV. To update automatically, set <b>csvUrl</b> in the CONFIG block of this file.</div>

<main id="app" class="hide">
  <div class="filters" id="filters"></div>
  <div class="kpis" id="kpis"></div>
  <div class="grid">
    <div class="panel wide"><h2>Games by month and final status</h2><div class="box"><canvas id="c_month"></canvas></div></div>
    <div class="panel"><h2>Final status</h2><div class="box"><canvas id="c_status"></canvas></div></div>
    <div class="panel"><h2>Shift</h2><div class="box"><canvas id="c_shift"></canvas></div></div>
    <div class="panel"><h2>Site</h2><div class="box"><canvas id="c_site"></canvas></div></div>
    <div class="panel"><h2>Live vs Offline</h2><div class="box"><canvas id="c_lob"></canvas></div></div>
    <div class="panel wide"><h2>Shift leaders by final status</h2><div class="box tall"><canvas id="c_sl"></canvas></div></div>
    <div class="panel"><h2>Hudl acquisition problems</h2><div class="box"><canvas id="c_prob"></canvas></div></div>
    <div class="panel"><h2>Hudl vs Alternative source</h2><div class="box"><canvas id="c_hudl"></canvas></div></div>
    <div class="panel"><h2>Game priority</h2><div class="box tall"><canvas id="c_prio"></canvas></div></div>
    <div class="panel"><h2>Top countries</h2><div class="box tall"><canvas id="c_country"></canvas></div></div>
    <div class="panel wide">
      <h2>Games</h2>
      <label style="max-width:320px;margin-bottom:10px">Search teams, competition, coordinator, ID<input type="search" id="q"></label>
      <div class="sub" id="tcount" style="margin-bottom:6px"></div>
      <div class="tbl"><table><thead><tr id="thead"></tr></thead><tbody id="tbody"></tbody></table></div>
    </div>
  </div>
</main>

<script>
/* ---- CONFIG ----
   csvUrl: Google Sheets > File > Share > Publish to web > pick the tab > CSV > copy the link here.
   Leave it empty to load a CSV by hand. refreshSec: how often the page re-reads the sheet. */
const CONFIG = { csvUrl: "", refreshSec: 60 };

const $ = s => document.querySelector(s);
let ALL = [], charts = {}, FILTERS = {};
const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const STATUS_ORDER = ["On-Videoapp", "Recovered", "Moved", "Blocked", "Planned", "Postponed", "Cancelled", "No status"];
const statusColor = () => ({
  "On-Videoapp": css("--g"), "Recovered": css("--g2"), "Moved": css("--a"), "Blocked": css("--r"),
  "Planned": css("--b"), "Postponed": css("--p"), "Cancelled": css("--mut"), "No status": css("--line")
});
const FILTER_DEFS = [
  ["Month", r => r._m], ["Shift", r => r["Shift"]], ["Site", r => r["Site"]],
  ["Shift leader", r => r._sl], ["Coordinator", r => r._co], ["Live / Offline", r => r["LOB"]]
];
const esc = s => String(s == null ? "" : s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

function classify(f) {
  if (!f) return "No status";
  if (f.startsWith("On-Videoapp Recovered")) return "Recovered";
  if (f.startsWith("On-Videoapp")) return "On-Videoapp";
  if (f.startsWith("Move")) return "Moved";
  if (f.startsWith("Blocked")) return "Blocked";
  if (["Planned", "Postponed", "Cancelled"].includes(f)) return f;
  return "No status";
}

function load(text) {
  const p = Papa.parse(text, { header: true, skipEmptyLines: true });
  ALL = p.data.map(r => {
    const o = {};
    for (const k in r) o[k.trim()] = typeof r[k] === "string" ? r[k].trim() : r[k];
    return o;
  }).filter(r => r["ID"]).map(r => {
    r._m = (r["Actual Acq. Date"] || "").slice(0, 7) || "No date";
    r._f = classify(r["Final Status"]);
    r._sl = (r["Shift leader"] || "").replace(/^\(A-\d+\)\s*/, "") || "Unassigned";
    r._co = (r["Coordinator"] || "").replace(/^\(A-\d+\)\s*/, "") || "Unassigned";
    return r;
  });
  $("#drop").classList.add("hide");
  $("#app").classList.remove("hide");
  buildFilters();
  render();
  $("#upd").textContent = ALL.length.toLocaleString() + " games · updated " + new Date().toLocaleTimeString();
}

function buildFilters() {
  const box = $("#filters");
  box.innerHTML = "";
  FILTER_DEFS.forEach(([name, fn]) => {
    const vals = [...new Set(ALL.map(fn).filter(Boolean))].sort();
    const l = document.createElement("label");
    l.textContent = name;
    const s = document.createElement("select");
    s.innerHTML = '<option value="">All</option>' + vals.map(v => `<option>${esc(v)}</option>`).join("");
    s.value = vals.includes(FILTERS[name]) ? FILTERS[name] : "";
    s.onchange = () => { FILTERS[name] = s.value; render(); };
    l.appendChild(s);
    box.appendChild(l);
  });
}

function filtered() {
  return ALL.filter(r => FILTER_DEFS.every(([n, fn]) => !FILTERS[n] || fn(r) === FILTERS[n]));
}

function count(rows, fn, skip) {
  const m = {};
  rows.forEach(r => { const k = fn(r); if (k && !(skip && skip.includes(k))) m[k] = (m[k] || 0) + 1; });
  return Object.entries(m).sort((a, b) => b[1] - a[1]);
}

function chart(id, cfg) {
  if (charts[id]) { charts[id].data = cfg.data; charts[id].options = cfg.options; charts[id].update(); }
  else charts[id] = new Chart($("#" + id), cfg);
}

function opts(horiz, stacked, legend) {
  return {
    indexAxis: horiz ? "y" : "x", maintainAspectRatio: false, animation: false,
    plugins: { legend: { display: legend, labels: { boxWidth: 10, color: css("--mut") } } },
    scales: {
      x: { stacked, grid: { display: horiz }, ticks: { color: css("--mut") }, beginAtZero: true },
      y: { stacked, grid: { display: !horiz }, ticks: { color: css("--mut") }, beginAtZero: true }
    }
  };
}

function bar(id, entries, horiz, color) {
  chart(id, {
    type: "bar",
    data: { labels: entries.map(e => e[0]), datasets: [{ data: entries.map(e => e[1]), backgroundColor: color || css("--g") }] },
    options: opts(horiz, false, false)
  });
}

function pie(id, entries) {
  const pal = [css("--g"), css("--b"), css("--a"), css("--p"), css("--g2"), css("--r")];
  chart(id, {
    type: "doughnut",
    data: { labels: entries.map(e => e[0]), datasets: [{ data: entries.map(e => e[1]), backgroundColor: entries.map((_, i) => pal[i % pal.length]), borderWidth: 0 }] },
    options: { maintainAspectRatio: false, animation: false, plugins: { legend: { position: "right", labels: { boxWidth: 10, color: css("--mut") } } } }
  });
}

function stacked(id, rows, keyFn, horiz, limit) {
  const m = {};
  rows.forEach(r => { const k = keyFn(r); if (!k) return; (m[k] = m[k] || {})[r._f] = (m[k][r._f] || 0) + 1; });
  let labels = Object.keys(m);
  if (limit) labels = labels.sort((a, b) => tot(m[b]) - tot(m[a])).slice(0, limit);
  else labels.sort();
  const colors = statusColor();
  const sets = STATUS_ORDER.filter(s => labels.some(l => m[l][s])).map(s => ({
    label: s, data: labels.map(l => m[l][s] || 0), backgroundColor: colors[s]
  }));
  chart(id, { type: "bar", data: { labels, datasets: sets }, options: opts(horiz, true, true) });
}
const tot = o => Object.values(o).reduce((a, b) => a + b, 0);

function render() {
  const rows = filtered();
  const n = rows.length || 1;
  const c = s => rows.filter(r => r._f === s).length;
  const done = c("On-Videoapp") + c("Recovered");
  const hudlRows = rows.filter(r => r["Hudl?"]);
  const lobRows = rows.filter(r => r["LOB"] === "Live" || r["LOB"] === "Offline");
  const pct = (a, b) => b ? (100 * a / b).toFixed(1) + "%" : "-";
  const kp = [
    [rows.length.toLocaleString(), "Games"],
    [pct(done, n), "On Videoapp (incl. recovered)"],
    [pct(c("Moved"), n), "Moved"],
    [c("Blocked").toLocaleString(), "Blocked"],
    [pct(hudlRows.filter(r => r["Hudl?"] === "Hudl").length, hudlRows.length), "Hudl source"],
    [pct(lobRows.filter(r => r["LOB"] === "Live").length, lobRows.length), "Live games"],
    [rows.filter(r => r["Hudl's Acq. Problems"]).length.toLocaleString(), "With acquisition problem"]
  ];
  $("#kpis").innerHTML = kp.map(k => `<div class="kpi"><b>${k[0]}</b><span>${k[1]}</span></div>`).join("");

  stacked("c_month", rows, r => r._m, false);
  const colors = statusColor();
  const st = count(rows, r => r._f);
  chart("c_status", {
    type: "doughnut",
    data: { labels: st.map(e => e[0]), datasets: [{ data: st.map(e => e[1]), backgroundColor: st.map(e => colors[e[0]]), borderWidth: 0 }] },
    options: { maintainAspectRatio: false, animation: false, plugins: { legend: { position: "right", labels: { boxWidth: 10, color: css("--mut") } } } }
  });
  stacked("c_shift", rows, r => r["Shift"], false);
  pie("c_site", count(rows, r => r["Site"]));
  pie("c_lob", count(rows, r => r["LOB"]));
  stacked("c_sl", rows, r => r._sl, true, 12);
  bar("c_prob", count(rows, r => r["Hudl's Acq. Problems"]), true, css("--a"));
  pie("c_hudl", count(rows, r => r["Hudl?"]));
  bar("c_prio", count(rows, r => r["Game Priority"]).slice(0, 10), true, css("--b"));
  bar("c_country", count(rows, r => r["Country"]).slice(0, 10), true, css("--g"));
  renderTable(rows);
}

const COLS = [["ID", "ID"], ["Actual Acq. Date", "Date"], ["Home Team", "Home"], ["Away Team", "Away"], ["Competition Name", "Competition"],
  ["Shift", "Shift"], ["Site", "Site"], ["_co", "Coordinator"], ["_sl", "Shift leader"], ["Final Status", "Final status"], ["Hudl's Acq. Problems", "Problem"]];

function renderTable(rows) {
  $("#thead").innerHTML = COLS.map(c => `<th>${c[1]}</th>`).join("");
  const q = $("#q").value.toLowerCase();
  let list = rows;
  if (q) list = rows.filter(r => ["ID", "Home Team", "Away Team", "Competition Name", "_co", "_sl"].some(k => String(r[k] || "").toLowerCase().includes(q)));
  list = list.slice().sort((a, b) => (b["Actual Acq. Date"] || "").localeCompare(a["Actual Acq. Date"] || ""));
  $("#tcount").textContent = `Showing ${Math.min(list.length, 200)} of ${list.length.toLocaleString()} games, newest first`;
  $("#tbody").innerHTML = list.slice(0, 200).map(r => "<tr>" + COLS.map(c => `<td title="${esc(r[c[0]])}">${esc(r[c[0]])}</td>`).join("") + "</tr>").join("");
}
$("#q").addEventListener("input", () => renderTable(filtered()));

/* ---- loading ---- */
function readFile(f) { const fr = new FileReader(); fr.onload = () => load(fr.result); fr.readAsText(f); }
$("#pick").onclick = () => $("#file").click();
$("#file").onchange = e => e.target.files[0] && readFile(e.target.files[0]);
const dz = $("#drop");
["dragover", "dragenter"].forEach(ev => document.addEventListener(ev, e => { e.preventDefault(); dz.classList.add("over"); }));
["dragleave", "drop"].forEach(ev => document.addEventListener(ev, e => { e.preventDefault(); dz.classList.remove("over"); }));
document.addEventListener("drop", e => e.dataTransfer.files[0] && readFile(e.dataTransfer.files[0]));

async function pull() {
  try {
    const u = CONFIG.csvUrl + (CONFIG.csvUrl.includes("?") ? "&" : "?") + "t=" + Date.now();
    const res = await fetch(u);
    if (!res.ok) throw new Error(res.status);
    load(await res.text());
  } catch (e) {
    $("#upd").textContent = "Could not reach the sheet (" + e.message + "). Check that it is published as CSV.";
  }
}
if (CONFIG.csvUrl) { pull(); setInterval(pull, CONFIG.refreshSec * 1000); }
</script>
</body>
</html>
